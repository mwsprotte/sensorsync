# Copie para /etc/sensorsync/sensorsync.env (permissao 600, dono root) e ajuste.
# NAO versione o arquivo real.

SENSORSYNC_DB_URL=jdbc:mysql://localhost:3306/sensor_sync_data?serverTimezone=America/Sao_Paulo
SENSORSYNC_DB_USER=sensorsync
SENSORSYNC_DB_PASSWORD=troque-esta-senha

# Endereco que vai no codigo gerado para as placas (IP fixo ou nome DNS do servidor).
# Vazio = usa o endereco digitado no navegador.
SENSORSYNC_PUBLIC_HOST=

SENSORSYNC_MQTT_BROKER=tcp://localhost:1883
SENSORSYNC_MQTT_USER=
SENSORSYNC_MQTT_PASSWORD=

# Senha do primeiro administrador (usada so quando o banco nao tem usuarios).
# Vazio = senha aleatoria mostrada uma vez no log (journalctl -u sensorsync).
SENSORSYNC_ADMIN_LOGIN=admin
SENSORSYNC_ADMIN_PASSWORD=

# Durante a migracao da versao 0.x: true aceita placas com a biblioteca antiga (sem token).
# Volte para false quando todas as placas usarem token.
SENSORSYNC_ALLOW_LEGACY_INGEST=false

# ---- TLS (HTTPS e MQTT com certificado) ----
# Com o perfil "tls" a interface e a API ficam em https://<servidor>:8443 e as placas
# usam MQTT na 8883. Os certificados sao criados sozinhos por sensorsync-tls.service.
# Remova a linha abaixo para voltar a HTTP puro (8080) e MQTT 1883.
SPRING_PROFILES_ACTIVE=tls
SENSORSYNC_TLS_DIR=/etc/sensorsync/tls
# ec (ECDSA P-256, padrao, mais leve nas placas) ou rsa (RSA-2048). Trocar cria uma CA nova:
# placas ja gravadas precisam do codigo gerado de novo.
SENSORSYNC_TLS_KEY=ec
# Porta 8080 com TLS ligado: redirect (redireciona para HTTPS, padrao), allow (aceita HTTP puro,
# so para experimentos de comparacao) ou off (fechada).
SENSORSYNC_PLAIN_HTTP=redirect
